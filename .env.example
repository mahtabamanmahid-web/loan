#------------------------------------------------------------------
# Application
#------------------------------------------------------------------
APP_NAME="Amar Loan"
APP_ENV=local
APP_KEY=
# NEVER true in production (leaks stack traces)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

# Default language: bn (Bangla) or en (English)
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------
# Database (MySQL)
#------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loan_system
DB_USERNAME=root
DB_PASSWORD=

#------------------------------------------------------------------
# Sessions (secure defaults for a financial app)
#------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site runs on HTTPS (required in production)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

#------------------------------------------------------------------
# Mail (password reset links & notifications)
#------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#------------------------------------------------------------------
# UddoktaPay payment gateway
# Docs: https://uddoktapay.readme.io/reference/api-information
#
# UddoktaPay uses ONE secret: the API key (sent as header RT-UDDOKTAPAY-API-KEY).
# There is no separate API secret. The key is used only on the server.
#
# Sandbox: UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com
#          UDDOKTAPAY_API_KEY=982d381360a69d419689740d9f2e26ce36fb7a50  (public sandbox key)
# Live:    UDDOKTAPAY_BASE_URL=https://pay.your-domain.com  (your UddoktaPay panel)
#          UDDOKTAPAY_API_KEY=<from your panel: Brand Settings → API Key>
#------------------------------------------------------------------
UDDOKTAPAY_MODE=sandbox
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com
UDDOKTAPAY_API_KEY=
# Leave the URLs below empty to use the built-in routes automatically:
#   callback -> {APP_URL}/payment/callback
#   cancel   -> {APP_URL}/payment/cancel
#   webhook  -> {APP_URL}/api/v1/payments/uddoktapay/webhook
UDDOKTAPAY_CALLBACK_URL=
UDDOKTAPAY_CANCEL_URL=
UDDOKTAPAY_WEBHOOK_URL=
UDDOKTAPAY_TIMEOUT=30

#------------------------------------------------------------------
# SMS (OTP & reminders)
# SMS_DRIVER=log writes SMS to storage/logs (development)
# SMS_DRIVER=http sends through your provider's HTTP API
#------------------------------------------------------------------
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_METHOD=POST
SMS_PARAM_API_KEY=api_key
SMS_PARAM_SENDER=senderid
SMS_PARAM_TO=number
SMS_PARAM_MESSAGE=message

#------------------------------------------------------------------
# First Super Admin (used once by `php artisan db:seed`).
# Remove these values after the first seed. Or use: php artisan admin:create
#------------------------------------------------------------------
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
